extends SceneTree
const ORE = preload("res://scripts/ore_state.gd")
const ORDERS = preload("res://scripts/customer_state.gd")
var failures := 0
func check(ok: bool, message: String) -> void:
	if ok: print("PASS orders: ", message)
	else:
		failures += 1
		push_error(message)
func _initialize() -> void:
	var ore = ORE.new()
	var orders = ORDERS.new()
	var counter := Vector2(166, 216)
	orders.step(8)
	check(orders.queue.size() == 1 and orders.coins == 100, "First arrival after eight seconds")
	check(not orders.decide(1, counter, 1, true), "Cannot accept while walking in")
	orders.step(2)
	check(orders.queue[0].remaining == 10, "Walking does not consume decision time")
	ore.pieces[0].kind = "horseshoe"
	ore.pickup(1, 0)
	check(not orders.deliver(1, counter, ore) and ore.carried_by(1) == 0, "Unaccepted order preserves carried product")
	check(not orders.decide(1, Vector2(166, 288), 1, true) and not orders.decide(1, counter, 2, true), "Wrong floor and stale request ID rejected")
	orders.step(9)
	check(orders.decide(1, counter, 1, true) and orders.queue[0].remaining == 30, "Acceptance starts independent 30-second deadline")
	orders.step(9)
	check(orders.queue.size() == 2 and orders.queue[1].remaining == 10, "Regular arrivals queue with full decision time")
	check(not orders.decide(2, counter, 1, false) and not orders.decide(2, counter, 1, true) and not orders.decide(2, counter, 2, true), "Accepted orders cannot reset or reject; queued orders cannot skip front")
	check(not orders.deliver(1, Vector2(260, 216), ore), "Delivery checks counter range")
	ore.pieces[0].kind = "sword"
	check(not orders.deliver(1, counter, ore), "Wrong finished item cannot fulfil order")
	ore.pieces[0].kind = "horseshoe"
	check(orders.deliver(1, counter, ore) and orders.coins == 110 and orders.reputation == 2, "Correct delivery awards coins and two reputation")
	check(not orders.deliver(1, counter, ore) and ore.pieces[0].delivered, "Cannot duplicate delivery reward")
	orders.step(2)
	check(orders.decide(1, counter, 2, false) and orders.reputation == -1 and orders.rejected == 1, "Explicit rejection costs three reputation")
	check(not orders.decide(2, counter, 2, false) and orders.reputation == -1, "Duplicate rejection has no penalty")
	orders.step(orders.until_arrival + 2)
	check(orders.decide(1, counter, 3, true), "Next arriving request can be accepted")
	orders.step(29.99)
	check(orders.missed == 0 and orders.queue[1].remaining == 10, "Queued decision timer stays paused behind accepted order")
	orders.step(0.01)
	check(orders.missed == 1 and orders.reputation == -7 and orders.coins == 110, "Accepted timeout costs six reputation and no coins")
	orders.step(10)
	check(orders.unanswered == 1 and orders.rejected == 2 and orders.reputation == -10, "Unanswered request auto-declines after ten seconds")
	var copy = ORDERS.new()
	copy.restore(orders.snapshot())
	check(copy.rejected == 2 and copy.unanswered == 1 and copy.missed == 1 and copy.reputation == -10, "Snapshot preserves decision outcomes and economy")
	var a = ORDERS.new()
	var b = ORDERS.new()
	a.step(100)
	for i in range(1000): b.step(0.1)
	check(a.number == b.number and a.rejected == b.rejected and a.reputation == b.reputation and a.queue.size() == b.queue.size(), "Large and small clock steps agree")
	print("ORDERS RESULT: ", failures, " failures")
	quit(1 if failures else 0)
