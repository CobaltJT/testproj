extends SceneTree
const TRANSPORT = preload("res://scripts/transport_state.gd")
const ECONOMY = preload("res://scripts/customer_state.gd")
const ORE = preload("res://scripts/ore_state.gd")
var failures := 0
func check(ok: bool, message: String) -> void:
	if ok: print("PASS transport: ", message)
	else:
		failures += 1
		push_error(message)
func _initialize() -> void:
	check(TRANSPORT.follow_cart_x(100, 100, 110) == 100, "Player stays still while cart moves across them")
	check(TRANSPORT.follow_cart_x(100, 110, 125) == 105, "Player follows only after far edge reaches them")
	check(TRANSPORT.follow_cart_x(105, 125, 95) == 105, "Reversing cart crosses player before moving them")
	check(TRANSPORT.follow_cart_x(105, 95, 80) == 100, "Opposite edge moves player after reversal")
	check(TRANSPORT.follow_cart_x(70, 100, 100) == 70 and TRANSPORT.follow_cart_x(70, 100, 101) == 71, "Outside coupling range preserves position and never snaps beyond actual cart movement")
	var model = TRANSPORT.new()
	var economy = ECONOMY.new()
	var ore = ORE.new()
	check(not model.upgrade(2, economy) and economy.coins == 100, "Elevator cannot skip first level")
	check(model.upgrade(1, economy) and economy.coins == 70 and model.tracks.size() == 4, "First upgrade unlocks first mine floor and starting rails on both sides")
	check(not model.upgrade(1, economy) and not model.can_rail(Vector2(326, 528)), "Cannot rebuy upgrades or build on locked floors")
	check(model.buy_rail(1, economy) and not model.place_rail(1, Vector2(294, 288)) and model.pending.has(1), "Rail cannot skip adjacent section and invalid placement retains kit")
	check(model.place_rail(1, Vector2(326, 288)) and not model.can_rail(Vector2(326, 288)), "Rail extends existing track exactly once")
	check(not model.can_rail(Vector2(NAN, 288)) and not model.can_rail(Vector2(390, 288)), "Off-grid shaft or nonfinite placement rejected")
	check(model.buy_cart(Vector2(240, 288), economy) == -1, "Cart purchase requires rails")
	var cart: int = model.buy_cart(Vector2(358, 288), economy)
	check(cart == 1 and economy.coins == 40, "Cart purchase charges once")
	model.move_cart(cart, -1000)
	check(model.carts[cart].at.x >= 310 and model.carts[cart].at.x < 312, "Cart stops at rail end, even for large movement")
	for i in range(25):
		var piece: int = ore.add_material("ore")
		check(model.store(cart, piece, ore), "Cart stores ore identity")
	var extra: int = ore.add_material("ore")
	check(not model.store(cart, extra, ore) and ore.is_loose(extra), "Cart capacity is exactly 25")
	var ingot: int = ore.add_material("ingot")
	check(not model.store(cart, ingot, ore), "Cart rejects intermediate products")
	check(model.take(cart, 1, ore) and ore.carried_by(1) == 8 and model.deposit(cart, 1, ore), "Ore withdrawal and manual loading preserve identity")
	model.move_cart(cart, 80)
	check(absf(model.carts[cart].at.x - 390) < 2, "Cart rolls onto stationary elevator bridge")
	check(model.start_lift(1), "Lift starts between unlocked stops")
	model.step_lift(0.5)
	check(model.lift_y == 328 and model.carts[cart].at.y == 328 and not model.supported(Vector2(390, 288)), "Elevator carries loaded cart and removes old bridge while moving")
	model.step_lift(1.5)
	check(model.lift_y == 448 and not model.moving and model.carts[cart].items.size() == 25, "Loaded cart reaches next floor intact")
	check(not model.start_lift(2) and not model.upgrade(3, economy), "Cannot travel or upgrade past locked level")
	var copy = TRANSPORT.new()
	copy.restore(model.snapshot())
	copy.carts[cart].items.clear()
	check(model.carts[cart].items.size() == 25, "Transport snapshot deep-copies cart contents")
	check(model.upgrade(2, economy), "Second level upgrade follows first")
	check(model.buy_rail(2, economy) and model.pending.has(2), "Rail kit can be reserved")
	model.cancel(2, economy)
	check(economy.coins == 10 and economy.refunds == 5, "Cancelled rail refunds original paid amount")
	print("TRANSPORT RESULT: ", failures, " failures")
	quit(1 if failures else 0)
